// schema.prisma
generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
}

// ==========================================
// ENUM TYPES
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ServicePriceType {
  FIXED
  HOURLY
  UNIT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OTPType {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

// ==========================================
// USER TABLES
// ==========================================

model User {
  user_id        String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  phone          String?   @unique
  password       String?   // Nullable untuk Google OAuth
  avatar         String?   @default("/profile.svg")
  role           UserRole  @default(USER)
  email_verified Boolean   @default(false)
  is_active      Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  otp_codes OTPCode[]
  bookings  Booking[]
  reviews   Review[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model OTPCode {
  otp_id     String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  email      String
  code       String   @db.VarChar(6) // 6-digit OTP code
  type       OTPType
  expires_at DateTime
  verified   Boolean  @default(false)

  created_at DateTime @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([email, type])
  @@index([code])
  @@index([user_id])
  @@map("otp_codes")
}

// ==========================================
// ADMIN TABLES
// ==========================================

model Admin {
  admin_id  String  @id @default(uuid()) @db.Uuid
  email     String  @unique
  name      String
  password  String  // Hashed password
  avatar    String?
  is_active Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@map("admins")
}

// ==========================================
// VENDOR/MITRA TABLES
// ==========================================

model Vendor {
  vendor_id   String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  password    String       // Hashed password
  name        String
  phone       String
  avatar      String?      @default("https://i.pravatar.cc/120")
  description String       @db.Text

  // Status & Verification
  verified Boolean      @default(false)
  status   VendorStatus @default(PENDING)

  // Ratings
  rating       Float @default(0)
  review_count Int   @default(0)

  // Service Info
  service_areas String[] // Array of service area names
  specialties   String[] // Array of specialty tags
  tags          String[] // Array of category tags
  category      String?  // Main category (ac, electrical, cleaning, etc.)

  // Metadata
  join_date  DateTime @default(now())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  services Service[]
  gallery  VendorGallery[]
  bookings Booking[]
  reviews  Review[]

  @@index([email])
  @@index([status])
  @@index([category])
  @@map("vendors")
}

model Service {
  service_id     String           @id @default(uuid()) @db.Uuid
  vendor_id      String           @db.Uuid
  name           String
  description    String           @db.Text
  price          Float
  price_type     ServicePriceType @default(FIXED)
  estimated_time String?          // e.g., "2-3 jam", "1-2 hari"
  is_active      Boolean          @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  vendor        Vendor        @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)
  booking_items BookingItem[]

  @@index([vendor_id])
  @@index([is_active])
  @@map("services")
}

model VendorGallery {
  gallery_id String  @id @default(uuid()) @db.Uuid
  vendor_id  String  @db.Uuid
  image_url  String
  caption    String?
  sort_order Int     @default(0)

  created_at DateTime @default(now())

  // Relations
  vendor Vendor @relation(fields: [vendor_id], references: [vendor_id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("vendor_gallery")
}

// ==========================================
// BOOKING TABLES
// ==========================================

model Booking {
  booking_id     String @id @default(uuid()) @db.Uuid
  booking_number String @unique // e.g., "BK-20240101-0001"

  // User Info
  user_id String @db.Uuid

  // Vendor Info
  vendor_id String @db.Uuid

  // Booking Details
  scheduled_date DateTime
  scheduled_time String   @db.VarChar(5) // e.g., "09:00"
  location       String
  notes          String?  @db.Text

  // Status
  status         BookingStatus @default(PENDING)
  payment_status PaymentStatus @default(PENDING)

  // Pricing
  subtotal    Float
  service_fee Float @default(0)
  total       Float

  // Metadata
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  completed_at DateTime?
  cancelled_at DateTime?

  // Relations
  user   User          @relation(fields: [user_id], references: [user_id])
  vendor Vendor        @relation(fields: [vendor_id], references: [vendor_id])
  items  BookingItem[]
  review Review?

  @@index([user_id])
  @@index([vendor_id])
  @@index([status])
  @@index([booking_number])
  @@map("bookings")
}

model BookingItem {
  booking_item_id String @id @default(uuid()) @db.Uuid
  booking_id      String @db.Uuid
  service_id      String @db.Uuid
  quantity        Int    @default(1)
  price           Float
  subtotal        Float

  // Relations
  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  service Service @relation(fields: [service_id], references: [service_id])

  @@index([booking_id])
  @@index([service_id])
  @@map("booking_items")
}

// ==========================================
// REVIEW TABLES
// ==========================================

model Review {
  review_id  String @id @default(uuid()) @db.Uuid
  booking_id String @unique @db.Uuid
  user_id    String @db.Uuid
  vendor_id  String @db.Uuid

  rating  Int     @db.SmallInt // 1-5
  comment String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [user_id])
  vendor  Vendor  @relation(fields: [vendor_id], references: [vendor_id])

  @@index([vendor_id])
  @@index([user_id])
  @@map("reviews")
}