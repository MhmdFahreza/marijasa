# Dockerfile.dev
FROM node:18-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache openssl libc6-compat git

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy prisma schema
COPY prisma ./prisma

# Generate Prisma Client
RUN npx prisma generate

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]